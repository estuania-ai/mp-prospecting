# MP Prospecting System — Variables de entorno
# Copiá este archivo como `.env` y completá los valores.
# NUNCA commitees `.env` con credenciales reales (.gitignore ya lo cubre).

# ── Flask ──────────────────────────────────────────────────────
FLASK_SECRET_KEY=cambiar_por_secreto_aleatorio_largo_en_prod
APP_BASE_URL=https://web-production-b6446.up.railway.app

# ── WhatsApp · backend selector ────────────────────────────────
# Valores: "evolution" (default · legacy) o "twilio" (nuevo · oficial)
WA_BACKEND=evolution

# ── Evolution API (legacy) ─────────────────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=mp_prospecting

# ── Twilio (nuevo backend) ─────────────────────────────────────
# Credenciales en console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número con prefijo whatsapp: y código país
TWILIO_WHATSAPP_FROM=whatsapp:+56935103447
# Opcional: Messaging Service SID si se agrupan números
TWILIO_MESSAGING_SID=
# CSV de números autorizados para /test-send (anti-mistake)
TWILIO_TEST_WHITELIST=56935103447

# ── LLM ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_BOT_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_BOT_MODEL=gpt-4o-mini

# ── Búsqueda / Scraping ────────────────────────────────────────
BRAVE_SEARCH_API_KEY=
BRAVE_MONTHLY_LIMIT=2000
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_DAILY_LIMIT=100
OUTSCRAPER_API_KEY=

# ── Email ──────────────────────────────────────────────────────
EMAIL_LOCAL_TOKEN=
EMAIL_LOCAL_URL=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_FROM_PHONE=

# ── Fast (integración interna · revisar política de credenciales) ─
FAST_LOCAL_URL=
FAST_LOCAL_TOKEN=
FAST_SESSION_JSON=data/fast_session.json
FAST_HEADLESS=true
MP_FAST_EMAIL=
MP_FAST_PASSWORD=

# ── Otros ──────────────────────────────────────────────────────
BOOKING_URL=
